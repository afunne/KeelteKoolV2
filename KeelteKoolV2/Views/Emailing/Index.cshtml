@model KeelteKoolV2.Models.Emailing.EmailViewModel

@{
    ViewData["Title"] = "Saada email";
}

<h1>Saada email</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="SendEmail" method="post" enctype="multipart/form-data">
            <div class="form-group">
                <label asp-for="To">Saaja</label>
                <input asp-for="To" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Subject">Teema</label>
                <input asp-for="Subject" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Body">Sisu</label>
                <textarea asp-for="Body" class="form-control" rows="6"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="Attachment">Manused</label>
                <input asp-for="Attachment" type="file" multiple class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary mt-2">Saada</button>
        </form>
    </div>
</div>
