@model KeelteKoolV2.Models.LanguageCourses.LanguageCourseViewModel

@{
    ViewData["Title"] = "Lisa kursus";
}

<h1>Lisa kursus</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <div class="form-group">
                <label asp-for="Nimetus"></label>
                <input asp-for="Nimetus" class="form-control" />
                <span asp-validation-for="Nimetus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Keel"></label>
                <input asp-for="Keel" class="form-control" />
                <span asp-validation-for="Keel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Tase"></label>
                <input asp-for="Tase" class="form-control" />
                <span asp-validation-for="Tase" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kirjeldus"></label>
                <textarea asp-for="Kirjeldus" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Kirjeldus" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary mt-2">Salvesta</button>
            <a asp-action="Index" class="btn btn-secondary mt-2">Tagasi</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
